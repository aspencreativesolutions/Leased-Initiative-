# Client Craft app URL when portfolio proxies /login, /studio, etc. (dev:all sets this automatically)
CLIENT_CRAFT_URL=http://127.0.0.1:3021

# Get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email address that receives contact form notifications
CONTACT_NOTIFICATION_EMAIL=your.email@example.com

# "From" address — must be a verified domain in Resend (or use onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=onboarding@resend.dev
