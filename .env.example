# ─── PayPal (server only — never commit real .env) ───
# Create app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_MODE=sandbox
# Optional: from PayPal Developer → Webhooks (for payment confirmation backup)
PAYPAL_WEBHOOK_ID=

# ─── Stripe (server only — never commit real .env) ───
# Test secret key: dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
# Optional: stripe listen --forward-to localhost:3001/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_MODE=test

# ─── Square (server only — never commit real .env) ───
# Developer Dashboard: https://developer.squareup.com/apps → your app → Sandbox
SQUARE_ACCESS_TOKEN=your_sandbox_access_token
SQUARE_APPLICATION_ID=sandbox-sq0idb-your_app_id
# Locations tab in your app (Sandbox) — ID starts with L
SQUARE_LOCATION_ID=your_sandbox_location_id
# Webhooks tab → create subscription → copy Signature Key (optional in local dev)
SQUARE_WEBHOOK_SIGNATURE_KEY=your_webhook_signature_key
# sandbox while testing, production when live
SQUARE_ENVIRONMENT=sandbox
# Must match the Notification URL host you register in Square Webhooks (ngrok URL in local dev)
# WEBHOOK_BASE_URL=https://your-subdomain.ngrok-free.app

# ─── App URLs ───
# Leased Initiative app: http://localhost:3021
# Merged with portfolio (npm run dev:all): http://localhost:3010
APP_URL=http://localhost:3021
PORT=3001
# Portfolio proxy target when running dev:all (Next.js on :3010)
CLIENT_CRAFT_URL=http://127.0.0.1:3021

# ─── Authentication (server only) ───
# Landlords and tenants both register with a standard email address.
JWT_SECRET=change-this-to-a-long-random-string

# ─── Email verification (server only) ───
# Required for account confirmation emails. Without SMTP, dev logs the verify link in the API terminal.
# Gmail example: use an App Password (Google Account → Security → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
MAIL_FROM_NAME=Leased
# Optional override for in-app bug reports (defaults to sophie@aspencreativesolutions.com)
# BUG_REPORT_EMAIL=sophie@aspencreativesolutions.com

# ─── SMS overdue pings (optional — Twilio) ───
# Server API POST /api/data/clients/:id/ping-overdue still uses Twilio when set.
# The Overdue Rent UI "Send Message to Tenant" opens the device Messages app instead,
# so tenant replies stay on the landlord’s personal phone.
# Without Twilio credentials, ping-overdue logs the message in the API terminal (dev mode).
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+15551234567

# ─── Public demo access (optional) ───
# Code visitors enter on the welcome carousel "Use Demo Account" flow.
# Admins can override this in Admin Mode; default is LEASED.
# DEMO_ACCESS_CODE=LEASED
# Company demo invite links from Admin Mode expire after this many days (1–365; default 14).
# COMPANY_DEMO_LINK_EXPIRY_DAYS=14

# ─── Frontend (public — safe in browser) ───
# Same Client ID as above (Sandbox app → Client ID)
VITE_PAYPAL_CLIENT_ID=your_sandbox_client_id
# Leave empty to use Vite proxy to localhost:3001
# VITE_API_URL=http://localhost:3001

# Google Maps (Maps JavaScript API + Places) for Add Rental address autocomplete
# and Edit Groups map-radius picker. Restrict the key to your app origin in
# Google Cloud Console. Geocoding is used via the JS Geocoder for centering a radius.
# VITE_GOOGLE_MAPS_API_KEY=your_browser_maps_api_key
