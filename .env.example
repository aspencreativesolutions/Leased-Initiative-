# ─── PayPal (server only — never commit real .env) ───
# Create app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_MODE=sandbox
# Optional: from PayPal Developer → Webhooks (for payment confirmation backup)
PAYPAL_WEBHOOK_ID=

# ─── App URLs ───
APP_URL=http://localhost:5173
PORT=3001

# ─── Frontend (public — safe in browser) ───
# Same Client ID as above (Sandbox app → Client ID)
VITE_PAYPAL_CLIENT_ID=your_sandbox_client_id
# Leave empty to use Vite proxy to localhost:3001
# VITE_API_URL=http://localhost:3001
